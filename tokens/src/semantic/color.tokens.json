{
  "color": {
    "$type": "color",
    "bg": {
      "page":    { "$value": "{color.sand.50}",   "$description": "Default page background." },
      "subtle":  { "$value": "{color.sand.100}",  "$description": "Alternate section background, e.g. the contact section." },
      "surface": { "$value": "{color.white}",     "$description": "Cards and raised surfaces." },
      "inverse": { "$value": "{color.navy.900}",  "$description": "Dark sections and the footer." }
    },
    "text": {
      "default": { "$value": "{color.navy.900}", "$description": "Headings and body text." },
      "muted":   { "$value": "{color.ink.600}",  "$description": "Secondary text, labels, captions. 5.3:1 on bg.page." },
      "inverse": { "$value": "{color.sand.50}",  "$description": "Text on bg.inverse and on action.primary." },
      "accent":  { "$value": "{color.gold.700}", "$description": "Emphasis in headings (the italic <em>). Only 2.3:1 on bg.page, so decorative only: never the sole carrier of meaning, never body-size text. See DECISIONS.md." }
    },
    "border": {
      "default": { "$value": "{color.sand.300}", "$description": "Dividers and resting input underlines." },
      "strong":  { "$value": "{color.navy.900}", "$description": "Focused or active input underline." }
    },
    "action": {
      "primary":       { "$value": "{color.navy.900}", "$description": "Primary button background." },
      "primary-hover": { "$value": "{color.navy.700}" },
      "accent":        { "$value": "{color.gold.500}", "$description": "Accent button background and secondary-link underline." }
    },
    "feedback": {
      "error":      { "$value": "{color.red.700}",   "$description": "The only error colour: field errors, invalid underlines, error alerts." },
      "error-bg":   { "$value": "{color.red.100}",   "$description": "Background of error alerts." },
      "success":    { "$value": "{color.green.700}", "$description": "The only success colour." },
      "success-bg": { "$value": "{color.green.100}" }
    },
    "focus": { "$value": "{color.navy.900}", "$description": "Keyboard focus ring." }
  }
}
