        "$value": "{red.700}",
        "$type": "color",
        "$description": "The only error colour: field errors, invalid underlines, error messages. 5.88:1 on background, 6.61 on surface, 5.42 on surface-subtle. Light surfaces only: 1.70:1 on color-surface-dark.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL",
            "STROKE_COLOR"
          ]
        }
      },
      "success": {
        "$value": "{green.700}",
        "$type": "color",
        "$description": "The only success colour. 6.27:1 on background, 7.06 on surface, 5.79 on surface-subtle. Light surfaces only: 1.60:1 on color-surface-dark.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL",
            "STROKE_COLOR"
          ]
