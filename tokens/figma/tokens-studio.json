      "border-rule": {
        "$value": "{navy.900}",
        "$type": "color",
        "$description": "Decorative strong lines: eyebrow rules, card top rules, the reading progress bar. Same value as color-border-strong, different role. On a dark surface it becomes color-border-rule-on-dark.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
        }
      },
      "border-highlight": {
        "$value": "{navy.300}",
        "$type": "color",
        "$description": "The light Highlight's left rule. Decorative (decision 31): 2.06:1 on color-surface-highlight.",
        "$extensions": {
          "com.figma.scopes": [
            "STROKE_COLOR"
          ]
