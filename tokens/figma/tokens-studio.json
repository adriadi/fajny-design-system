        "$value": "{gold.500}",
        "$type": "color",
        "$description": "Brand gold fill: accent button background, secondary-link underline. Text on it: color-text-on-accent. Not a text colour on light backgrounds.",
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
