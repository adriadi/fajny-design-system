  "color": {
    "color": {
      "text": {
        "$value": "{navy.900}",
        "$type": "color",
        "$description": "All text: headings, body, labels, links, eyebrows, metric numbers. The only main text colour (decision 20). On a dark surface it becomes color-text-on-dark.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "text-muted": {
        "$value": "{stone.600}",
        "$type": "color",
        "$description": "Secondary text: captions, meta, hints. 4.85:1 or better on every light background. On a dark surface it becomes color-text-muted-on-dark.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "text-placeholder": {
        "$value": "{color.text-muted}",
        "$type": "color",
        "$description": "Input placeholders (decision 19). Forms appear only on light surfaces.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "text-emphasis": {
        "$value": "{gold.800}",
        "$type": "color",
        "$description": "Gold italic words in headings (decision 18). Allowed only in display, title and heading, the roles that never go below 24px (decision 28). Never in subheading, card-title or text roles: at 3.5–3.8:1 on the beige backgrounds (4.3:1 on white) it passes AA only as large text. On a dark surface it becomes color-text-emphasis-on-dark.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "text-on-action": {
        "$value": "{sand.50}",
        "$type": "color",
        "$description": "Text on color-action and color-action-hover. On a dark surface, where the action turns gold, it becomes color-text-on-accent.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "text-on-accent": {
        "$value": "{navy.900}",
        "$type": "color",
        "$description": "Text on gold fills (color-accent, color-action-on-dark). Always navy, on every surface: sand on gold is 1.6:1.",
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ]
        }
      },
      "background": {
