{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Syne", "sans-serif"], "$description": "Headings, card titles, the wordmark." },
      "body":    { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Everything else." }
    },
    "weight": {
      "$type": "fontWeight",
      "light":    { "$value": 300, "$description": "Long-form muted copy." },
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500, "$description": "Headings, buttons, nav." },
      "semibold": { "$value": 600, "$description": "Eyebrows and tags." }
    },
    "size": {
      "$type": "dimension",
      "xs":         { "$value": "11px", "$description": "Eyebrows, form labels, tags (uppercase)." },
      "sm":         { "$value": "13px", "$description": "Meta text, captions, field errors, nav." },
      "md":         { "$value": "15px", "$description": "Body text, inputs, buttons." },
      "lg":         { "$value": "18px", "$description": "Lead paragraphs." },
      "xl":         { "$value": "22px", "$description": "Card titles." },
      "heading-sm": { "$value": "clamp(22px, 2.5vw, 30px)", "$description": "Sub-section headings, e.g. form headings." },
      "heading-md": { "$value": "clamp(32px, 4vw, 52px)",   "$description": "Section titles." },
      "display":    { "$value": "clamp(52px, 7vw, 96px)",   "$description": "One per page: the hero heading." }
    },
    "line-height": {
      "$type": "number",
      "tight":  { "$value": 1.1,  "$description": "Headings." },
      "snug":   { "$value": 1.3,  "$description": "Card titles." },
      "normal": { "$value": 1.65, "$description": "Body text." }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.025em", "$description": "Headings." },
      "wide":  { "$value": "0.06em",   "$description": "Uppercase buttons and nav." },
      "wider": { "$value": "0.12em",   "$description": "Uppercase eyebrows and labels." }
    }
  }
}
